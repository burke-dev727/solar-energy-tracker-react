# "eia" (default) calls the EIA API live; "databricks" reads the gold tables built by the Databricks job;
# "snapshot" reads a file made with `go run . export-snapshot` (path in SNAPSHOT_PATH, default snapshot.json).
DATA_SOURCE=eia

EIA_API_KEY=your-eia-api-key

# Required when DATA_SOURCE=databricks. Host and HTTP path are on the SQL warehouse's
# "Connection details" tab; the token is a personal access token.
DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=your-personal-access-token
# Catalog and schema holding the gold tables built by the energy-etl job.
DATABRICKS_SCHEMA=workspace.energy

# Enables the chat assistant (also requires DATA_SOURCE=databricks or snapshot).
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
# Optional: gpt-6-luna is cheaper, gpt-6-astra more capable.
OPENAI_MODEL=gpt-6.1-sol
# Optional: none, low, medium, or high. Higher is slower but reasons more carefully.
OPENAI_REASONING_EFFORT=low
# Optional: an OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
# OPENAI_BASE_URL=
